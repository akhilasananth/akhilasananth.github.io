---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer/Footer.astro";
import About from "../assets/about.md";
import styles from "./Styles/Home.module.css";
import ImageReveal from "../components/ImageReveal/ImageReveal";
---

<BaseLayout isWelcome={false}>
    <h1 slot="header" style={{"padding-left": "4.5rem"}}>~$ whoami</h1>
    <div class={styles.main} slot="main">
        <div style={{"display": "flex", "alignItems": "center", "flexDirection": "column"}}>
            <div id="markdown-container" class={styles.textContainer}>
                <About/>
            </div>
            <span class={styles.scrollDownText}> Scroll Down </span>
        </div>
        <ImageReveal selector="#markdown-container" underImgPath="/images/about/me.png"
                     overImgPath="images/about/ghibli_me.png" client:load/>
    </div>
    <Footer content="Built with Astro and React.js. Deployed using GitHub Pages." slot="footer"/>
</BaseLayout>


