---
import BaseLayout from "../layouts/BaseLayout/BaseLayout.astro";
import Footer from "../components/Footer/Footer.astro";
import styles from "./Styles/Home.module.css";
import About from "../components/About/About.astro";
import ImageReveal from "../components/ImageReveal/ImageReveal";
---
<!--TODO: refactor styles to classes-->

<BaseLayout isWelcome={false}>
    <h1 slot="header">~$ whoami</h1>
    <div class={styles.main} slot="main">
        <About/>
        <ImageReveal selector="#markdown-container" underImgPath="/images/about/me.png"
                     overImgPath="images/about/ghibli_me.png" client:load/>
    </div>
    <Footer content="Built with Astro and React.js. Deployed using GitHub Pages." slot="footer"/>
</BaseLayout>


