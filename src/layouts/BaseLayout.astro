---
import clsx from 'clsx';
import Nav from '../components/Nav/Nav';
import HomeNav from "../components/HomeNav/HomeNav";
import styles from "../../public/styles/layouts.module.css"

type Props = {
    titleAddOn?: string | undefined,
    header?: boolean,
    footer?: boolean,
    isWelcome?: boolean,
}

const {
    titleAddOn = "",
    isWelcome = false,
} = Astro.props

const {header, footer} = Astro.slots;
const className = clsx({'welcome-bg': isWelcome, 'default-bg': !isWelcome});
const title = `Akhila Ananth${titleAddOn ? `: ${titleAddOn}` : ""}`;

const currentPagePath = Astro.url.pathname
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="stylesheet" href="/styles/layouts.module.css"/>
    <link rel="icon" type="image/jpeg" href="/images/me_icon.ico"/>
    <title>{title}</title>

</head>
<body class={className}>
<header class={styles.header}>
    {!isWelcome ?
            <HomeNav currentPagePath={currentPagePath} client:load/> : null}
    {header &&
            <slot name="header"/>}
</header>

<main class={styles.content}>
    {!isWelcome ?
            <Nav client:load/> : null}
    <slot name="main"/>
</main>

<footer>
    {footer &&
            <slot name="footer"/>}
</footer>
</body>
</html>