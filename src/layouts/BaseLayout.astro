---
import Footer from "../components/Footer/Footer.astro";
import clsx from 'clsx';

type Props = {
    titleAddOn?: string | undefined,
    header?: boolean,
    footer?: boolean,
    isWelcome?: boolean,
}

const {
    titleAddOn = "",
    isWelcome = false,
} = Astro.props

const {header, footer} = Astro.slots;
const className = clsx({'welcome-bg': isWelcome, 'default-bg': !isWelcome});
const title = `Akhila Ananth${titleAddOn ? `: ${titleAddOn}` : ""}`;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="stylesheet" href="/styles/layouts.css"/>
    <link rel="icon" type="image/jpeg" href="/images/me_icon.ico"/>
    <title>{title}</title>

</head>
<body class={className}>
<header>
    {header &&
            <slot name="header"/>}
</header>

<main class="content">
    <slot/>
</main>

<footer>
    {footer &&
            <slot name="footer"/>}
</footer>
</body>
</html>